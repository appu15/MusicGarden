{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run fetch-model && npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(mediapipe|models)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
